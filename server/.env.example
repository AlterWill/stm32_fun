APP_NAME=Voice Note Server
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./data/notes.db
# DATABASE_URL=postgresql+psycopg://voicenotes:password@localhost:5432/voicenotes

AUDIO_DIR=./data/audio
# Default firmware length is 60 seconds. Increase both values for longer notes.
# At 16 kHz, 16-bit mono: one minute is about 1.92 MB; five minutes is 9.6 MB.
MAX_AUDIO_SECONDS=300
COMMAND_TTL_SECONDS=600

# openssl rand -hex 32
DEVICE_API_KEY=change-me-device-api-key

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=90

# openssl rand -hex 32
SESSION_SECRET=change-me-session-secret
COOKIE_SECURE=false

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

APP_TIMEZONE=UTC
ASK_CONTEXT_NOTES=10
