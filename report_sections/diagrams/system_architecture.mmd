flowchart LR
    User["User / web browser"] -->|"Record request"| Server["FastAPI server<br/>Note storage and web interface"]
    Server -->|"Recording command"| ESP["ESP32<br/>Wi-Fi and HTTP"]
    Mic["INMP441<br/>Digital microphone"] -->|"I2S audio"| STM["STM32 Nucleo-F446RE<br/>Audio capture and display control"]
    STM -->|"PCM audio frames"| ESP
    ESP -->|"Status and start commands"| STM
    STM -->|"I2C status text"| OLED["SSD1306 OLED<br/>128 × 64"]
    ESP -->|"Chunked WAV upload"| Server
    Server -->|"Optional AI request"| AI["Gemini service"]
    AI -->|"Transcription and structured note"| Server
    Server -->|"Playback and note results"| User
