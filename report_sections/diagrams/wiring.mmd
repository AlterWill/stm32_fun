flowchart LR
    subgraph MIC["INMP441 microphone"]
        MSCK["SCK"]
        MWS["WS"]
        MSD["SD"]
        MP["VDD / GND / L-R"]
    end
    subgraph STM["STM32 Nucleo-F446RE"]
        PB10["PB10: I2S2 clock"]
        PB12["PB12: I2S2 word select"]
        PC3["PC3: I2S2 data"]
        PB9["PB9: I2C SDA"]
        PB8["PB8: I2C SCL"]
        PC6["PC6: USART6 TX"]
        PC7["PC7: USART6 RX"]
    end
    subgraph OLED["SSD1306 OLED"]
        SDA["SDA"]
        SCL["SCL"]
        OP["VCC / GND"]
    end
    subgraph ESP["ESP32"]
        RX["GPIO16: RX"]
        TX["GPIO17: TX"]
    end
    MSCK --- PB10
    MWS --- PB12
    MSD --- PC3
    PB9 --- SDA
    PB8 --- SCL
    PC6 --> RX
    TX --> PC7
    MP --- POWER["3.3 V / GND / GND<br/>L-R selects left channel"]
    OP --- OPOWER["3.3 V / GND<br/>Confirm module compatibility"]
    GROUND["Common ground between boards"] --- STM
    GROUND --- ESP
    USB["Separate USB power"] --- STM
    USB --- ESP
